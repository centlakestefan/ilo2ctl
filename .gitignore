# Build artifacts / compiler output
build/
CMakeUserPresets.json
*.class
*.exe
*.o
*.obj

# Downloaded tooling (CFR decompiler, etc.)
_tools/

# HP proprietary applet and everything derived from it — do NOT redistribute,
# and do NOT commit. The repo does not ship the jar and nothing in the build or
# the test suite needs it: the validation it produced is frozen in
# tests/oracle/. These rules exist for the one case that still wants it —
# regenerating those fixtures from a jar you obtained from an iLO 2 yourself
# (tests/oracle/README.md) — so that a local copy can never be committed.
rc175p10.jar
*.jar
_decomp/
_extract/

# Local iLO credential (alternative to the ILO_PASS env var)
.ilo_pass

# Local agent/editor settings
.claude/settings.local.json

# Misc
*.log
# ...but testdata/ holds captured hardware behaviour, not build noise.
!testdata/*.log
__pycache__/
